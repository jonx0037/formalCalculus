---
import { DIFFICULTY_BADGE_CLASSES, type Difficulty } from '../../lib/topicMeta';

type Variant = 'prereq' | 'internal' | 'formalml' | 'formalstatistics';

interface Props {
  title: string;
  href: string;
  relationship?: string;
  variant: Variant;
  external?: boolean;
  difficulty?: Difficulty;
  domainLabel?: string;
  readTime?: number;
}

const {
  title,
  href,
  relationship,
  variant,
  external = false,
  difficulty,
  domainLabel,
  readTime,
} = Astro.props;

const variantStyles: Record<Variant, { bg: string; border: string; accent: string }> = {
  prereq: {
    bg: 'var(--color-proof-bg)',
    border: 'var(--color-proof-border)',
    accent: 'var(--color-text-muted)',
  },
  internal: {
    bg: 'var(--color-theorem-bg)',
    border: 'var(--color-theorem-border)',
    accent: 'var(--color-theorem-border)',
  },
  formalml: {
    bg: 'var(--color-definition-bg)',
    border: 'var(--color-definition-border)',
    accent: 'var(--color-primary)',
  },
  formalstatistics: {
    bg: 'var(--color-statistics-bg)',
    border: 'var(--color-warning)',
    accent: 'var(--color-warning)',
  },
};

const style = variantStyles[variant];

const hasMeta = Boolean(difficulty || domainLabel || readTime);
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="group block rounded-md border-l-4 p-4 transition-all hover:shadow-sm hover:-translate-y-px no-underline"
  style={`background: ${style.bg}; border-left-color: ${style.border};`}
>
  {hasMeta && (
    <div class="flex flex-wrap items-center gap-2 mb-2 text-[0.65rem] uppercase tracking-wider">
      {difficulty && (
        <span
          class={`px-1.5 py-0.5 rounded-full border font-semibold ${DIFFICULTY_BADGE_CLASSES[difficulty]}`}
        >
          {difficulty}
        </span>
      )}
      {domainLabel && (
        <span class="font-medium" style="color: var(--color-text-muted);">
          {domainLabel}
        </span>
      )}
      {readTime && (
        <>
          <span style="color: var(--color-border);" aria-hidden="true">·</span>
          <span style="color: var(--color-text-muted);">{readTime} min</span>
        </>
      )}
    </div>
  )}

  <div class="flex items-start justify-between gap-2">
    <p
      class="font-semibold text-sm leading-snug"
      style={`color: ${style.accent};`}
    >
      {title}
      {external && <span class="ml-1 opacity-70 text-xs" aria-hidden="true">↗</span>}
    </p>
    {!external && (
      <span
        class="shrink-0 text-sm opacity-0 -translate-x-1 transition-all group-hover:opacity-70 group-hover:translate-x-0"
        style={`color: ${style.accent};`}
        aria-hidden="true"
      >→</span>
    )}
  </div>

  {relationship && (
    <p class="mt-1.5 text-xs leading-relaxed" style="color: var(--color-text);">
      {relationship}
    </p>
  )}
</a>
