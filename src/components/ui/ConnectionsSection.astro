---
import { getCollection } from 'astro:content';
import {
  getPrerequisites,
  getDownstream,
  type ConnectionAnnotation,
  type ConnectedTopic,
} from '../../lib/connections';
import { domainLabel, type Difficulty } from '../../lib/topicMeta';
import ConnectionCard from './ConnectionCard.astro';

interface Props {
  slug: string;
  connections?: ConnectionAnnotation[];
  downstreamConnections?: ConnectionAnnotation[];
  // The schema's `site: 'formalml'` literal is carried on the content side but
  // the component doesn't need it here — every entry renders as a formalML card.
  formalmlConnections?: Array<{
    topic: string;
    title?: string;
    relationship: string;
  }>;
}

const {
  slug,
  connections = [],
  downstreamConnections = [],
  formalmlConnections = [],
} = Astro.props;

const prereqs = getPrerequisites(slug, connections);
const downstream = getDownstream(slug, downstreamConnections);

const hasAny =
  prereqs.length > 0 || downstream.length > 0 || formalmlConnections.length > 0;

// ML / analysis jargon that should stay uppercase. Extend as needed.
const ACRONYMS = new Set([
  'ai', 'ml', 'ai', 'pac', 'rkhs', 'kl', 'sgd', 'mcmc', 'vae', 'gan',
  'ode', 'pde', 'sde', 'fft', 'dft', 'rl', 'nn', 'cnn', 'rnn', 'lstm',
  'dkw', 'ubp', 'ftc', 'ivt', 'evt',
]);

function titleize(id: string, explicit?: string): string {
  if (explicit) return explicit;
  return id
    .split('-')
    .map((w) =>
      ACRONYMS.has(w.toLowerCase())
        ? w.toUpperCase()
        : w.charAt(0).toUpperCase() + w.slice(1),
    )
    .join(' ');
}

// Pull difficulty + read-time from the content collection so cards can show
// them alongside the graph data. ConnectionCard stays "dumb" — enrichment is
// scoped to this orchestration component.
type TopicMeta = {
  difficulty: Difficulty;
  estimatedReadTime: number;
};

const topics = hasAny ? await getCollection('topics') : [];
const metaMap = new Map<string, TopicMeta>(
  topics.map((t) => [
    t.id,
    {
      difficulty: t.data.difficulty,
      estimatedReadTime: t.data.estimatedReadTime,
    },
  ]),
);

type EnrichedCard = ConnectedTopic & Partial<TopicMeta> & { domainLabel?: string };

function enrichCards(cards: ConnectedTopic[]): EnrichedCard[] {
  return cards.map((c) => ({
    ...c,
    difficulty: metaMap.get(c.id)?.difficulty,
    estimatedReadTime: metaMap.get(c.id)?.estimatedReadTime,
    domainLabel: domainLabel(c.domain),
  }));
}

const prereqCards = enrichCards(prereqs);
const downstreamCards = enrichCards(downstream);
---

{
  hasAny && (
    <section class="mt-16 pt-8 border-t" style="border-color: var(--color-border);">
      <h2
        class="text-xl font-bold mb-6"
        style="font-family: var(--font-serif); color: var(--color-text-heading);"
      >
        Connections & Further Reading
      </h2>

      {prereqCards.length > 0 && (
        <div class="mb-8">
          <h3
            class="text-xs font-semibold mb-3 uppercase tracking-wider flex items-center gap-2"
            style="color: var(--color-text-muted);"
          >
            <span
              class="inline-block w-1 h-4 rounded"
              style="background: var(--color-proof-border);"
              aria-hidden="true"
            />
            Prerequisites — topics you need first
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {prereqCards.map((p) => (
              <ConnectionCard
                title={p.label}
                href={p.url}
                relationship={p.relationship}
                variant="prereq"
                difficulty={p.difficulty}
                domainLabel={p.domainLabel}
                readTime={p.estimatedReadTime}
              />
            ))}
          </div>
        </div>
      )}

      {downstreamCards.length > 0 && (
        <div class="mb-8">
          <h3
            class="text-xs font-semibold mb-3 uppercase tracking-wider flex items-center gap-2"
            style="color: var(--color-theorem-border);"
          >
            <span
              class="inline-block w-1 h-4 rounded"
              style="background: var(--color-theorem-border);"
              aria-hidden="true"
            />
            Where this leads — next in formalCalculus
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {downstreamCards.map((d) => (
              <ConnectionCard
                title={d.label}
                href={d.url}
                relationship={d.relationship}
                variant="internal"
                difficulty={d.difficulty}
                domainLabel={d.domainLabel}
                readTime={d.estimatedReadTime}
              />
            ))}
          </div>
        </div>
      )}

      {formalmlConnections.length > 0 && (
        <div class="mb-8">
          <h3
            class="text-xs font-semibold mb-3 uppercase tracking-wider flex items-center gap-2"
            style="color: var(--color-primary);"
          >
            <span
              class="inline-block w-1 h-4 rounded"
              style="background: var(--color-primary);"
              aria-hidden="true"
            />
            On to formalML — where this calculus powers ML
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {formalmlConnections.map((c) => (
              <ConnectionCard
                title={titleize(c.topic, c.title)}
                href={`https://formalml.com/topics/${c.topic}`}
                relationship={c.relationship}
                variant="formalml"
                external
              />
            ))}
          </div>
        </div>
      )}
    </section>
  )
}
