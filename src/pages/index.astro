---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tracks } from '../data/curriculum';
import CurriculumGraph from '../components/viz/CurriculumGraph.tsx';
---

<BaseLayout title="formalCalculus">
  <!-- Hero -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 sm:py-24 text-center">
    <h1
      class="text-4xl sm:text-5xl font-bold mb-4"
      style="font-family: var(--font-serif); color: var(--color-text-heading);"
    >
      formal<span style="color: var(--color-primary);">Calculus</span>
    </h1>
    <p class="text-xl mb-2" style="color: var(--color-text-muted);">
      The calculus and analysis foundations behind modern machine learning.
    </p>
    <p class="text-base mb-8 max-w-2xl mx-auto" style="color: var(--color-text-muted);">
      Deep-dive explainers combining rigorous mathematics, interactive visualizations, and working code.
      The prequel to <a href="https://formalstatistics.com" class="text-[var(--color-warning)] hover:underline" target="_blank" rel="noopener">formalStatistics</a> and <a href="https://formalml.com" class="text-[var(--color-primary)] hover:underline" target="_blank" rel="noopener">formalML</a>.
    </p>
    <div class="flex justify-center gap-4">
      <a
        href="/paths"
        class="px-6 py-3 rounded-lg text-white font-semibold transition-colors"
        style="background: var(--color-primary);"
      >
        View Curriculum
      </a>
      <a
        href="https://github.com/jonx0037/formalCalculus"
        target="_blank"
        rel="noopener"
        class="px-6 py-3 rounded-lg font-semibold border transition-colors"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        GitHub
      </a>
    </div>
  </section>

  <!-- Tracks overview -->
  <section class="max-w-5xl mx-auto px-4 sm:px-6 pb-16">
    <h2
      class="text-2xl font-bold mb-8 text-center"
      style="font-family: var(--font-serif); color: var(--color-text-heading);"
    >
      10 Tracks · 32 Topics
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {tracks.map((track) => (
        <a
          href={`/paths#${track.domain}`}
          class="group rounded-lg border p-4 transition-all hover:shadow-md hover:-translate-y-0.5 no-underline"
          style="background: var(--color-surface-alt); border-color: var(--color-border);"
        >
          <h3
            class="font-semibold mb-1 transition-colors group-hover:text-[var(--color-primary)]"
            style="color: var(--color-text-heading);"
          >
            {track.title}
          </h3>
          <p class="text-sm mb-2" style="color: var(--color-text-muted);">
            {track.description}
          </p>
          <p
            class="text-xs flex items-center justify-between"
            style="color: var(--color-text-muted);"
          >
            <span>{track.published.length} published · {track.planned.length} planned</span>
            <span
              class="opacity-0 group-hover:opacity-100 transition-opacity font-semibold"
              style="color: var(--color-primary);"
            >
              Explore →
            </span>
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Curriculum graph preview -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pb-16">
    <h2
      class="text-2xl font-bold mb-2 text-center"
      style="font-family: var(--font-serif); color: var(--color-text-heading);"
    >
      How the topics connect
    </h2>
    <p
      class="text-base mb-8 text-center max-w-2xl mx-auto"
      style="color: var(--color-text-muted);"
    >
      The full prerequisite graph — every arrow is a concept you'll want before the next.
      Hover a node for details, or
      <a href="/paths" class="text-[var(--color-primary)] hover:underline">view the full curriculum</a>.
    </p>
    <CurriculumGraph client:visible />
  </section>

  <!-- Bridges to downstream sites: formalStatistics and formalML -->
  <section
    class="border-t py-12"
    style="border-color: var(--color-border); background: var(--color-surface-alt);"
  >
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <p class="text-lg mb-6" style="color: var(--color-text-heading); font-family: var(--font-serif); font-weight: 700;">
        Where this leads →
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="rounded-lg border p-5" style="border-color: var(--color-warning); background: var(--color-surface);">
          <p class="text-sm mb-3" style="color: var(--color-text-muted);">
            Probability and statistics built on this calculus — distributions, estimation, hypothesis testing, Bayesian inference.
          </p>
          <a
            href="https://formalstatistics.com"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-semibold hover:underline"
            style="color: var(--color-warning);"
          >
            Visit formalStatistics →
          </a>
        </div>
        <div class="rounded-lg border p-5" style="border-color: var(--color-primary); background: var(--color-surface);">
          <p class="text-sm mb-3" style="color: var(--color-text-muted);">
            Machine learning theory built on this calculus — optimization, learning theory, generative modeling.
          </p>
          <a
            href="https://formalml.com"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-2 font-semibold hover:underline"
            style="color: var(--color-primary);"
          >
            Visit formalML →
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
