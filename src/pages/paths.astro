---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tracks } from '../data/curriculum';
import TopicCard from '../components/ui/TopicCard.astro';
import CurriculumGraph from '../components/viz/CurriculumGraph.tsx';
import graphData from '../data/curriculum-graph.json';

const domainLabels: Record<string, string> = {
  'limits-continuity': 'Limits & Continuity',
  'single-variable': 'Single-Variable Calculus',
  'multivar-differential': 'Multivariable Differential',
  'multivar-integral': 'Multivariable Integral',
  'series-approximation': 'Series & Approximation',
  'odes': 'ODEs',
  'measure-integration': 'Measure & Integration',
  'functional-analysis': 'Functional Analysis',
};

// Group nodes by domain
const nodesByDomain = new Map<string, typeof graphData.nodes>();
for (const node of graphData.nodes) {
  const existing = nodesByDomain.get(node.domain) || [];
  existing.push(node);
  nodesByDomain.set(node.domain, existing);
}
---

<BaseLayout title="Curriculum" description="The full formalCalculus curriculum — 32 topics across 8 tracks.">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <header class="mb-12 text-center">
      <h1
        class="text-3xl sm:text-4xl font-bold mb-3"
        style="font-family: var(--font-serif); color: var(--color-text-heading);"
      >
        Curriculum
      </h1>
      <p class="text-lg" style="color: var(--color-text-muted);">
        32 topics across 8 tracks — from limits to functional analysis.
      </p>
      <p class="text-sm mt-2" style="color: var(--color-text-muted);">
        Every topic connects forward to
        <a href="https://formalml.com/paths" class="text-[var(--color-primary)] hover:underline" target="_blank" rel="noopener">
          formalML
        </a>
        topics it enables.
      </p>
    </header>

    <!-- Interactive prerequisite DAG -->
    <section class="mb-16">
      <h2
        class="text-xl font-bold mb-1"
        style="font-family: var(--font-serif); color: var(--color-text-heading);"
      >
        Prerequisite Graph
      </h2>
      <p class="text-sm mb-4" style="color: var(--color-text-muted);">
        The full dependency graph — arrows show prerequisites. Filled nodes are published topics.
      </p>
      <CurriculumGraph client:visible />
    </section>

    {tracks.map((track) => {
      const nodes = nodesByDomain.get(track.domain) || [];
      return (
        <section class="mb-12">
          <h2
            class="text-xl font-bold mb-1"
            style="font-family: var(--font-serif); color: var(--color-text-heading);"
          >
            {track.title}
          </h2>
          <p class="text-sm mb-4" style="color: var(--color-text-muted);">
            {track.description}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {nodes.map((node) => (
              <TopicCard
                title={node.label}
                description=""
                url={node.url}
                difficulty={
                  node.id.includes('inverse') || node.id.includes('surface') ||
                  node.id.includes('approximation') || node.id.includes('sigma') ||
                  node.id.includes('lebesgue') || node.id.includes('lp-') ||
                  node.id.includes('radon') || node.id.includes('banach') ||
                  node.id.includes('hilbert') || node.id.includes('calculus-of')
                    ? 'advanced'
                    : node.id.includes('sequences') || node.id.includes('epsilon-delta') ||
                      node.id.includes('derivative') || node.id.includes('riemann') ||
                      node.id.includes('gradient') || node.id.includes('series-conv') ||
                      node.id.includes('first-order')
                    ? 'foundational'
                    : 'intermediate'
                }
                domain={node.domain}
                status={node.status as 'published' | 'planned'}
              />
            ))}
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>
