---
import BaseLayout from './BaseLayout.astro';
import ReferencesSection from '../components/ui/ReferencesSection.astro';
import ConnectionsSection from '../components/ui/ConnectionsSection.astro';
import { DIFFICULTY_BADGE_CLASSES, domainLabel } from '../lib/topicMeta';

interface Props {
  slug: string;
  frontmatter: {
    title: string;
    subtitle: string;
    difficulty: 'foundational' | 'intermediate' | 'advanced';
    estimatedReadTime: number;
    abstract: string;
    domain: string;
    datePublished: Date;
    tags: string[];
    connections?: Array<{
      topic: string;
      relationship: string;
    }>;
    downstreamConnections?: Array<{
      topic: string;
      relationship: string;
    }>;
    formalmlConnections?: Array<{
      topic: string;
      title?: string;
      site: 'formalml';
      relationship: string;
    }>;
    formalstatisticsConnections?: Array<{
      topic: string;
      title?: string;
      site: 'formalstatistics';
      relationship: string;
    }>;
    hideAutomaticConnections?: boolean;
    references: Array<{
      type: 'book' | 'paper';
      title: string;
      authors: string;
      year: number;
      url?: string;
      note?: string;
    }>;
  };
}

const { slug, frontmatter } = Astro.props;

---

<BaseLayout title={frontmatter.title} description={frontmatter.abstract}>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
    <!-- Header -->
    <header class="mb-10">
      <div class="flex items-center gap-3 mb-4 text-sm">
        <a
          href="/paths"
          class="text-[var(--color-text-muted)] hover:text-[var(--color-text)] transition-colors"
        >
          {domainLabel(frontmatter.domain)}
        </a>
        <span class="text-[var(--color-border)]">·</span>
        <span
          class={`px-2 py-0.5 rounded-full text-xs font-semibold border ${DIFFICULTY_BADGE_CLASSES[frontmatter.difficulty]}`}
        >
          {frontmatter.difficulty}
        </span>
        <span class="text-[var(--color-border)]">·</span>
        <span class="text-[var(--color-text-muted)]">{frontmatter.estimatedReadTime} min read</span>
      </div>

      <h1
        class="text-3xl sm:text-4xl font-bold mb-3"
        style="font-family: var(--font-serif); color: var(--color-text-heading);"
      >
        {frontmatter.title}
      </h1>

      <p class="text-lg" style="color: var(--color-text-muted);">
        {frontmatter.subtitle}
      </p>
    </header>

    <!-- Abstract -->
    <div
      class="mb-10 p-4 rounded-lg border"
      style="background: var(--color-surface-alt); border-color: var(--color-border);"
    >
      <p class="text-sm leading-relaxed" style="color: var(--color-text);">
        <strong>Abstract.</strong> {frontmatter.abstract}
      </p>
    </div>

    <!-- Topic content (MDX) -->
    <div class="topic-content">
      <slot />
    </div>

    <!-- Structured connections: prerequisites, downstream topics, formalML forward refs.
         Suppressed when frontmatter.hideAutomaticConnections = true (for topics that
         author their own in-content callouts with richer prose). -->
    {!frontmatter.hideAutomaticConnections && (
      <ConnectionsSection
        slug={slug}
        connections={frontmatter.connections}
        downstreamConnections={frontmatter.downstreamConnections}
        formalmlConnections={frontmatter.formalmlConnections}
        formalstatisticsConnections={frontmatter.formalstatisticsConnections}
      />
    )}

    <!-- Structured references from frontmatter -->
    {frontmatter.references && frontmatter.references.length > 0 && (
      <ReferencesSection references={frontmatter.references} />
    )}
  </article>
</BaseLayout>
